# Copy to .env next to docker-compose.yml and fill in.

# Which build to run: main (latest from the main branch), a version such as
# 1.2.0 from a v1.2.0 tag, or a commit's short SHA.
IMAGE_TAG=main

# The apex the relay owns. Shares get <project>-<label>.BEACON_DOMAIN.
BEACON_DOMAIN=relay.example.com

# Who may open tunnels: label:token pairs, comma or newline separated.
# The label namespaces that person's URLs (shop-dean.relay.example.com) and must be a
# lowercase DNS label. Make tokens with: openssl rand -hex 24
BEACON_TOKENS=dean:replace-with-openssl-rand-hex-24

# Labels from BEACON_TOKENS whose tokens are admin tokens. An admin can make
# tokens for other people from Beacon's Settings (or `beacon relay invite`),
# list them and revoke them. Tokens made that way are kept in the relay-data
# volume, not here.
BEACON_ADMINS=dean

# What the apex (https://BEACON_DOMAIN) shows a browser: site for the Beacon
# website, or card for a single card saying what the server is.
BEACON_HOME=site

# Traefik's names on your server.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare

# Log every relayed request.
BEACON_VERBOSE=false
